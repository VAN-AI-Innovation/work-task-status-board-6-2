# 심사자가 클론 직후 키 없이 실행하는 기본값. 시드가 로드돼 대시보드가 바로 뜬다.
# 실제 저장소에 붙일 때만 supabase로 바꾼다.
STORAGE_DRIVER=memory

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용. `NEXT_PUBLIC_`을 붙이지 마라 — 브라우저 번들에 그대로 실린다 (npm run guard:env가 막는다).
SUPABASE_SERVICE_ROLE_KEY=

# T8 데모 계정 (scripts/db/seed-auth.ts가 만든다). 실제 값은 .env.local에만 둔다.
T8_SEED_PASSWORD=
T8_SEED_EMAIL_DOMAIN=example.com
