# ── 이 파일의 목적 ──────────────────────────────────────────────
# 심사자가 클론 직후 `cp .env.example .env.local` 한 번으로 키 없이 돌릴 수 있어야 한다.
# **실제 키 값은 이 파일에 넣지 않는다.** 값이 필요한 키는 빈 채로 두고 얻는 곳만 적는다.
# ────────────────────────────────────────────────────────────────

# `memory`(데모·기본값) 또는 `supabase`(실저장소).
# 설정하지 않으면 앱이 Supabase를 먼저 시도하고, 자격증명이 없으면 **읽기 전용 폴백**으로
# 내려앉는다 (조회는 되지만 업로드 확정·수정이 503). 데모로 쓰려면 memory를 명시할 것.
STORAGE_DRIVER=memory

# 실저장소·로그인에 필요하다. 브라우저 번들에 실려도 되는 두 값이다.
# Supabase 대시보드 → Project Settings → API 에서 얻는다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용. 업로드 확정과 `/api/uploads/seed`만 쓴다 (RLS를 통째로 우회하는 키다).
# ⚠ `NEXT_PUBLIC_` 접두사를 붙이지 마라 — 브라우저 번들에 그대로 실린다.
#    붙이면 `npm run guard:env`(prebuild)가 빌드를 실패시킨다.
# 같은 API 화면의 service_role 항목에서 얻는다.
SUPABASE_SERVICE_ROLE_KEY=

# `npm run seed:auth`가 만드는 역할 계정(admin·lead·member) 설정. 로컬 시드 전용이라
# 배포 환경변수에는 넣지 않는다.
# 비워 두면 스크립트가 난수 24자를 만들어 `.env.local`에 덧붙인다.
T8_SEED_PASSWORD=
T8_SEED_EMAIL_DOMAIN=example.com

# ── 여기에 없는 환경변수 세 개 ──────────────────────────────────
# · NODE_ENV        — Next.js·npm이 직접 정한다. `.env`에 적으면 안 되는 값이다.
# · service_role 키에 NEXT_PUBLIC_ 접두사를 붙인 이름 두 개 — 코드에는 `src/lib/env-guard.test.ts`의
#   **탐지 픽스처로만** 존재한다. 실제로 쓰는 키가 아니므로 여기에 적지 않는다.
# · SKIP_LIVE_DB    — `vitest.config.ts`가 읽는 셸 스위치다 (`.env`가 아니라 명령 앞에 붙인다).
